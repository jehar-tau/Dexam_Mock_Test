  "scoringRules": {
    "msqLadderIITB2026": {
      "description": "UCEED/CEED 2026 MSQ: four options, one or more correct.",
      "rules": [
        { "when": "chosen set equals the correct set exactly", "marks": 4 },
        { "when": "all four options correct and exactly three chosen, none wrong", "marks": 3 },
        { "when": "three or more options correct and exactly two chosen, both correct, none wrong", "marks": 2 },
        { "when": "two or more options correct and exactly one chosen, it is correct, none wrong", "marks": 1 },
        { "when": "nothing chosen", "marks": 0 },
        { "when": "any other case (any incorrect option chosen)", "marks": -1 }
      ],
      "verification": { "status": "verified", "sources": ["U26", "C26"] }
    }
  },
