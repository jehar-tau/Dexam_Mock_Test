{
  "version": 1,
  "target": "https://staging.example.invalid",
  "sessions": 150,
  "activeAttempts": 75,
  "iterations": 10,
  "thresholds": {
    "maxErrorRate": 0.01,
    "publicP95Ms": 2500,
    "authenticatedP95Ms": 500
  },
  "scenarios": {
    "browser": [
      { "name": "portal-shell", "method": "GET", "path": "/" }
    ],
    "activeAttempt": [
      {
        "name": "read-attempt",
        "method": "POST",
        "path": "/rest/v1/rpc/read_attempt",
        "headers": {
          "apikey": { "env": "CAPACITY_ANON_KEY" },
          "authorization": "Bearer {accessToken}",
          "content-type": "application/json"
        },
        "body": { "p_id": "{attemptId}" }
      },
      {
        "name": "autosave-answer",
        "method": "POST",
        "path": "/rest/v1/rpc/save_answer_revision",
        "headers": {
          "apikey": { "env": "CAPACITY_ANON_KEY" },
          "authorization": "Bearer {accessToken}",
          "content-type": "application/json"
        },
        "body": {
          "p_attempt_id": "{attemptId}",
          "p_question_id": "{questionId}",
          "p_answer": "{answer}",
          "p_revision": "{revision}"
        }
      }
    ]
  }
}
