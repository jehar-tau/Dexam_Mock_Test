# Use a NEW DesignMocks Supabase project. Never reuse Dexam staging or production.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PORTAL_ENABLED=false
# Controlled owner testing only; server registration allowlist must be configured first.
VITE_TEST_LOGIN_ENABLED=false
VITE_STAGING_PORTAL_ENABLED=false
# Set only after final terms/privacy notices are published and the backend matches.
VITE_TERMS_VERSION=
# Razorpay keys belong only in the separate Supabase Edge Function secret store.

# Independent checkout gate: keep false until merchant, policies and real test journey pass.
VITE_CHECKOUT_ENABLED=false
# Expanded modules are for explicit nonproduction regression previews only.
VITE_POST_LAUNCH_PREVIEW=false
