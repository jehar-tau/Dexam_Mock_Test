{
  "name": "designmocks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "dev:e2e": "vite --host 127.0.0.1 --port 4399 --strictPort",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview --host 127.0.0.1 --port 4191 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright install chromium && playwright test && node scripts/check-browser-results.mjs",
    "test:e2e:full": "DMOCKS_E2E_SCOPE=full npm run test:e2e",
    "test:e2e:system-deps": "playwright install-deps chromium",
    "test:e2e:install": "playwright install chromium",
    "test:hosted-setup": "node scripts/check-hosted-setup.mjs",
    "test:bank-readiness": "python3 -m unittest discover -s tests -p \"*_test.py\"",
    "bank:manifest": "node scripts/question-bank-import.mjs --ref origin/main",
    "bank:import": "node scripts/question-bank-import.mjs --ref origin/main --apply",
    "media:manifest": "node scripts/private-bank-media.mjs --ref origin/main",
    "media:import": "node scripts/private-bank-media.mjs --ref origin/main --apply",
    "check": "npm test && npm run test:bank-readiness && node scripts/check-mvp-profile.mjs && npm run build && node scripts/check-preview-isolation.mjs && npm run test:server-types && npm run test:e2e",
    "test:server-types": "npx --yes deno@2.9.6 check supabase/functions/*/index.ts",
    "test:database": "bash scripts/check-database.sh",
    "runtime:manifest": "node scripts/materialize-bank-runtime.mjs --ref origin/main",
    "runtime:apply": "node scripts/materialize-bank-runtime.mjs --ref origin/main --apply",
    "runtime:nid": "node scripts/materialize-nid-practice.mjs --ref origin/main",
    "capacity:run": "node scripts/capacity-load.mjs",
    "operations:sweep": "node scripts/operations-sweep.mjs",
    "bank:reconcile": "node scripts/reconcile-bank-state.mjs",
    "bank:diagnostics": "node scripts/bank-conversion-report.mjs"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "0.0.46",
    "@supabase/supabase-js": "2.117.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
